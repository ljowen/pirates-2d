{
  "name": "pirates2d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run sheet && vite build",
    "preview": "vite preview",
    "bench": "esbuild scripts/bench.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/bench.mjs --log-level=error && node node_modules/.cache/bench.mjs",
    "sheet": "esbuild scripts/buildSheet.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/buildSheet.mjs --log-level=error \"--external:node:*\" && node node_modules/.cache/buildSheet.mjs docs/sprite-sheet.svg"
  },
  "dependencies": {
    "@fontsource/alegreya": "5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/im-fell-english": "5.3.0",
    "@fontsource/pirata-one": "5.3.0",
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
